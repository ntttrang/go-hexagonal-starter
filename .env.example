# Application
APP_ENV=development
APP_PORT=8085
LOG_LEVEL=info

# Observability / OpenTelemetry
OTEL_SERVICE_NAME=go-hexagonal-starter
SERVICE_VERSION=1.0.0
# Leave empty to disable tracing (no-op provider). Observability compose sets otel-collector:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_hexagonal
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# JWT
JWT_SECRET=8f4c1a9e7b2d6f03c9a5e8b14d7f2c96a0b3e5d9f1c8a64b7e2d0f9a3c6b8e15
JWT_ISSUER=go-hexagonal-starter
JWT_EXPIRY=24h

# Migrations
MIGRATIONS_PATH=file://migrations
